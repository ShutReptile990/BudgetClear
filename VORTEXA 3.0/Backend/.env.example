# Both FastAPI processes load Backend/.env automatically. Restart after editing.
# Use local to keep using existing SQLite accounts/reports while configuring cloud services.
BUDGETCLEAR_STORAGE_BACKEND=supabase
SUPABASE_URL=
# Supabase project Settings > API: anon key or publishable key. No service-role key needed.
SUPABASE_ANON_KEY=
SUPABASE_CSV_BUCKET=budgetclear-csv
# Set to 1 only when the website is served over HTTPS.
BUDGETCLEAR_COOKIE_SECURE=0

# OpenAI-compatible Chat Completions endpoint. Enter your provider's base URL,
# key, and model ID. Base URL ends at /v1 (do not append /chat/completions).
# Leaving key or model empty uses evidence-based detector explanations instead.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=120
# Beyond this limit, flags still receive a linked detector explanation.
AI_MAX_FLAGS=500

MAX_UPLOAD_MB=20
MAX_LEDGER_ROWS=50000
